# api for add admin
###
POST http://127.0.0.1:8000/admin-register/
Content-Type: application/json

{
    "username":"admin",
    "email":"admin@gmail.com",
    "password":1234
}

#api for list all turf
###
GET http://127.0.0.1:8000/turf/
Accept: application/json
Authorization: Basic admin:1234

#create a record api 
###
POST http://127.0.0.1:8000/turf/
Content-Type: application/json
Authorization: Basic admin:1234

{
    "name": "City Football Arena",
    "location": "Perinthalmanna",
    "email": "cityarena@gmail.com",
    "phone_number": 9876543212
}

#api calling to detail for record
###
GET http://127.0.0.1:8000/turf/2/
Accept: application/json
Authorization: Basic admin:1234

#api for updating record
###
PUT http://127.0.0.1:8000/turf/2/
Content-Type: application/json
Authorization: Basic admin:1234

{
  "name": "Green Valley Turf",
  "location": "perinthalamnna",
  "email": "valley@gmail.com",
  "phone_number": 9639028191
}

#api for deleting record
###
DELETE http://127.0.0.1:8000/turf/1/
Accept: application/json
Authorization: Basic admin:1234


# api for calling turf team booking =====

#api for calling list all team register record
###
GET http://127.0.0.1:8000/register/
Accept: application/json

# add to booking team
###
POST http://127.0.0.1:8000/register/
Content-Type: application/json

{
    "team_name":"lokha-team",

    "phone_number":5679327898,

    "date":"2026-08-4",

    "duration":"2 hours"
}

# api for listing details
###
GET http://127.0.0.1:8000/register/3/
Accept: application/json

# api for updating record
###
PUT http://127.0.0.1:8000/register/3/
Content-Type: application/json

{
    "team_name":"rush-team",

    "phone_number":9979327898,

    "date":"2026-08-9",

    "duration":"2 hours"
}


# api for deleting record
###
DELETE http://127.0.0.1:8000/register/3/
Accept: application/json

# =======  bookin_v2 =======

# calling to signup user
###
POST http://127.0.0.1:8000/v2/booking/signup/
Content-Type: application/json

{
    "username":"drf",
    "email":"drf@gmail.com",
    "password":"password@123"
}

# listing all booked records api
###
GET http://127.0.0.1:8000/v2/booking/turf/booking/
Accept: application/json
Authorization: Basic drf:password@123

#api for booking turf
###
POST http://127.0.0.1:8000/v2/booking/turf/booking/
Content-Type: application/json
Authorization: Basic drf:password@123

{
   "name":"liminar",
   "location":"thrisue",
   "email":"luminar@gmail.com",
   "phone_number":"8128380834",
   "duration":"07:30 AM"
}


#api for detail for record
###
GET http://127.0.0.1:8000/v2/booking/turf/booking/2/
Accept: application/json
Authorization: Basic drf:password@123

# api for updating record
###
PUT http://127.0.0.1:8000/v2/booking/turf/booking/2/
Content-Type: application/json
Authorization: Basic drf:password@123

{
   "name":"big-b",
   "location":"kochi",
   "email":"big-b@gmail.com",
   "phone_number":"8928380834",
   "duration":"02:10 AM"
}

# api for calling to delete record
###
